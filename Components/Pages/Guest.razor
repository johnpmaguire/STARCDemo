@page "/guest"
@layout GuestLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Nav

<div class="guest-page">
    <div class="guest-page-wrapper">

        <!-- Hero Section -->
        <section id="hero">
            <article class="hero-card">

                <h1>Welcome to STARC</h1>

                <div class="hero-badge">
                    <img src="images/0-5k-badge.png" alt="STARC 0 to 5K Badge">
                </div>

                <div class="hero-text">
                    <p><span>From couch to confidence. </span>No matter your fitness level, our 0 to 5K plan is designed for anyone who wants to get moving at their own pace.</p>
                    <p><span>Want to improve your fitness. </span>We offer both focused training and social runs. Meet new prople, make friends and enjoy being active.</p>

                    <p><span>Signed up for a marathon. </span>Not sure where to start. </p>

                    <p>Join a network of runners who will welcome, guide, coach and cheer you on every step of your journey.</p>
                    @if (!showDetails)
                    {
                        <div class="hero-tagline">
                            <p>Train with STARC.</p>
                            <p>Everyone welcome. No one left behind.</p>
                        </div>
                        <button class="cta" @onclick="RevealDetails">Learn more</button>
                    }
                </div>

            </article>
        </section>

        @if (showDetails)
        {
            <!-- What We Do -->
            <section id="what-we-do" class="reveal-section">
                <h2 class="section-title">What We Do</h2>

                <div class="tab-container">
                    <div class="tab-bar" role="tablist">
                        <button role="tab"
                                class="tab-btn @(activeTab == "beginners" ? "active" : "")"
                                aria-selected="@(activeTab == "beginners")"
                                @onclick='() => SetTab("beginners")'>
                            🏃 0–5K Beginners
                        </button>
                        <button role="tab"
                                class="tab-btn @(activeTab == "club" ? "active" : "")"
                                aria-selected="@(activeTab == "club")"
                                @onclick='() => SetTab("club")'>
                            🌙 Club Nights
                        </button>
                        <button role="tab"
                                class="tab-btn @(activeTab == "events" ? "active" : "")"
                                aria-selected="@(activeTab == "events")"
                                @onclick='() => SetTab("events")'>
                            🏅 Events &amp; Community
                        </button>
                    </div>

                    <div class="tab-panel @(isTabFading ? "tab-fading" : "tab-visible")" role="tabpanel">

                        <div class="tab-content @(activeTab == "beginners" ? "tab-active" : "tab-hidden")">
                            <h3>0–5K Beginners</h3>
                            <p>Start your journey with support and confidence. Our beginner programme is designed for anyone — no experience needed, no judgement, just encouragement.</p>
                            <p>More detail coming soon — training schedule, what to expect on your first night, and how to sign up.</p>
                        </div>

                        <div class="tab-content @(activeTab == "club" ? "tab-active" : "tab-hidden")">
                            <h3>Club Nights</h3>
                            <p>Social runs for all abilities — relaxed and welcoming. Whether you are just finishing the 0–5K or you have been running for years, there is a group for you.</p>
                            <p>More detail coming soon — session times, routes, and what to bring.</p>
                        </div>

                        <div class="tab-content @(activeTab == "events" ? "tab-active" : "tab-hidden")">
                            <h3>Events &amp; Community</h3>
                            <p>Races, socials, volunteering, and being part of something bigger. We enter local and national events together and celebrate every finish line.</p>
                            <p>More detail coming soon — upcoming events, parkrun, and how to get involved.</p>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Back to Home -->
            <div class="back-home">
                <a href="@Nav.BaseUri" class="cta">← Back to Home</a>
            </div>

            <!-- Meet the Team — Option A: Flip Cards -->
            <section id="team-flip" class="reveal-section">
                <h2 class="section-title">Meet the Team — Flip Cards</h2>
                <div class="leader-cards">
                    @foreach (var leader in leaders)
                    {
                        <div class="flip-card">
                            <div class="flip-card-inner">
                                <div class="flip-card-front">
                                    <img src="@leader.ImageUrl" alt="@leader.Name" />
                                    <h3>@leader.Name</h3>
                                    <p class="leader-role">@leader.Role</p>
                                </div>
                                <div class="flip-card-back">
                                    <h3>@leader.Name</h3>
                                    <p class="leader-role">@leader.Role</p>
                                    <p class="leader-bio">@leader.ShortBio</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

          

            <!-- Meet the Team — Option B: Cards + Modal -->
            <section id="team-modal" class="reveal-section">
                <h2 class="section-title">Meet the Team — Modal</h2>
                <div class="leader-cards">
                    @foreach (var leader in leaders)
                    {
                        <div class="leader-card" @onclick="() => OpenLeader(leader)">
                            <img src="@leader.ImageUrl" alt="@leader.Name" />
                            <h3>@leader.Name</h3>
                            <p class="leader-role">@leader.Role</p>
                            <span class="leader-more">Learn more</span>
                        </div>
                    }
                </div>
            </section>

            @if (selectedLeader is not null)
            {
                <div class="leader-modal-backdrop" @onclick="CloseLeader">
                    <div class="leader-modal" @onclick:stopPropagation="true">
                        <button class="leader-modal-close" @onclick="CloseLeader">✕</button>
                        <img src="@selectedLeader.ImageUrl" alt="@selectedLeader.Name" />
                        <h3>@selectedLeader.Name</h3>
                        <p class="leader-role">@selectedLeader.Role</p>
                        <p class="leader-bio">@selectedLeader.FullBio</p>
                    </div>
                </div>
            }

            <!-- Training Overview -->
            <section id="training" class="reveal-section">
                <h2 class="section-title">Training Overview</h2>
                <ul>
                    <li>Monday — Social Run</li>
                    <li>Wednesday — Club Night</li>
                    <li>Friday — Intervals</li>
                    <li>Sunday — Long Run</li>
                </ul>
            </section>

            <!-- Why Run With Us -->
            <section id="why-run" class="reveal-section">
                <h2 class="section-title">Why Run With Us</h2>
                <p>We are a friendly, supportive community that helps you build confidence, strength, and a love for running — no matter where you start.</p>
            </section>

            <!-- Back to Home -->
            <div class="back-home">
                <a href="@Nav.BaseUri" class="cta">← Back to Home</a>
            </div>
        }
    </div>
</div>



@code {
    private string activeTab = "beginners";
    private bool isTabFading = false;

    private async Task SetTab(string tab)
    {
        if (activeTab == tab) return;

        isTabFading = true;
        StateHasChanged();
        await Task.Delay(400);

        activeTab = tab;
        isTabFading = false;
        StateHasChanged();
    }

    private bool showDetails = false;
    private void RevealDetails() => showDetails = true;

    // ── Team ────────────────────────────────────────────────
    private record LeaderModel(
        string Name,
        string Role,
        string ImageUrl,
        string ShortBio,
        string FullBio
    );

    private LeaderModel? selectedLeader;
    private void OpenLeader(LeaderModel leader) => selectedLeader = leader;
    private void CloseLeader() => selectedLeader = null;

    private readonly List<LeaderModel> leaders =
    [
        new("Sarah Connor", "Head Coach", "/images/team/sarah.jpg",
            "10 years coaching, marathon finisher, loves a muddy trail.",
            "Sarah has been coaching with STARC for 10 years. A multiple marathon finisher and ultrarunner, she is passionate about getting beginners off the couch and across finish lines. She leads the 0–5K programme and club nights on Wednesday."),

        new("James Murphy", "0–5K Lead", "/images/team/james.png",
            "Couch to 5K graduate turned coach. Your biggest cheerleader.",
            "James started exactly where you are now — nervous, unfit, and unsure. He completed the 0–5K programme four years ago and never looked back. Now he leads it himself, bringing warmth and patience to every session."),

        new("Priya Nair", "Events Coordinator", "/images/team/priya.jpg",
            "Organises all club events and races. Spreadsheet wizard.",
            "Priya keeps STARC's social and race calendar running like clockwork. From local parkruns to national marathons, she coordinates entries, logistics, and the all-important post-race celebrations."),
    ];
}