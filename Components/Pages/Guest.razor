@page "/guest"
@layout GuestLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="gt-page">
    <div class="gt-wrapper">

        <!-- Hero -->
        <section class="gt-hero">
            <div class="gt-hero-card">
                <h1>Welcome to STARC</h1>

                <img class="gt-badge" src="images/0-5k-badge.png" alt="STARC 0 to 5K Badge" />

                <div class="gt-hero-body">
                    <p><strong>From couch to confidence.</strong> No matter your fitness level, our 0 to 5K plan is designed for anyone who wants to get moving at their own pace.</p>
                    <p><strong>Want to improve your fitness.</strong> We offer both focused training and social runs. Meet new people, make friends and enjoy being active.</p>
                    <p><strong>Signed up for a marathon.</strong> Not sure where to start. Start with STARC</p>
                    <p>Join a network of runners who will welcome, guide, coach and cheer you on every step of your journey.</p>

                    @if (!showDetails)
                    {
                        <p class="gt-tagline">Why train with STARC.<br />Everyone welcome. No one left behind.</p>
                        <button class="gt-cta" @onclick="async () => await RevealDetails()">Learn more</button>
                    }
                </div>
            </div>
        </section>

        @if (showDetails)
        {
            <!-- What We Do -->
            <section id="what-we-do" class="gt-section gt-reveal">
                <h2 class="gt-section-title">What We Do</h2>

                <div class="gt-tabs">
                    <div class="gt-tab-bar" role="tablist">
                        <button role="tab"
                                class="gt-tab-btn @(activeTab == "beginners" ? "gt-tab-active" : "")"
                                aria-selected="@(activeTab == "beginners")"
                                @onclick='() => SetTab("beginners")'>
                            🏃 0–5K Beginners
                        </button>
                        <button role="tab"
                                class="gt-tab-btn @(activeTab == "club" ? "gt-tab-active" : "")"
                                aria-selected="@(activeTab == "club")"
                                @onclick='() => SetTab("club")'>
                            🌙 Club Nights
                        </button>
                        <button role="tab"
                                class="gt-tab-btn @(activeTab == "events" ? "gt-tab-active" : "")"
                                aria-selected="@(activeTab == "events")"
                                @onclick='() => SetTab("events")'>
                            🏅 Events &amp; Community
                        </button>
                    </div>

                    <div class="gt-tab-panel @(isTabFading ? "gt-fading" : "")">
                        @if (activeTab == "beginners")
                        {
                            <h3>0–5K Beginners</h3>
                            <p>Start your journey with support and confidence. Our beginner programme is designed for anyone — no experience needed, no judgement, just encouragement.</p>
                            <p>More detail coming soon — training schedule, what to expect on your first night, and how to sign up.</p>
                        }
                        else if (activeTab == "club")
                        {
                            <h3>Club Nights</h3>
                            <p>Social runs for all abilities — relaxed and welcoming. Whether you are just finishing the 0–5K or you have been running for years, there is a group for you.</p>
                            <p>More detail coming soon — session times, routes, and what to bring.</p>
                        }
                        else
                        {
                            <h3>Events &amp; Community</h3>
                            <p>Races, socials, volunteering, and being part of something bigger. We enter local and national events together and celebrate every finish line.</p>
                            <p>More detail coming soon — upcoming events, parkrun, and how to get involved.</p>
                        }
                    </div>
                </div>
            </section>

            <!-- Meet the Team — Flip Cards -->
            <section class="gt-section gt-reveal">
                <h2 class="gt-section-title">Meet some of the Team</h2>
                <div class="gt-leader-grid">
                    @foreach (var leader in leaders)
                    {
                        <div class="gt-flip-card">
                            <div class="gt-flip-inner">
                                <div class="gt-flip-front">
                                    <img src="@leader.ImageUrl" alt="@leader.Name" class="gt-avatar" />
                                    <h3>@leader.Name</h3>
                                    <p class="gt-role">@leader.Role</p>
                                </div>
                                <div class="gt-flip-back">
                                    <h3>@leader.Name</h3>
                                    <p class="gt-role">@leader.Role</p>
                                    <p class="gt-bio">@leader.ShortBio</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Training Overview -->
            <section class="gt-section gt-reveal">
                <h2 class="gt-section-title">Training Overview</h2>
                <ul class="gt-list">
                    <li>Monday — Social Run</li>
                    <li>Wednesday — Straight Run</li>
                    <li>Friday — Intervals</li>
                    <li>Sunday — Long Run</li>
                </ul>
            </section>

            <!-- Why Run With Us -->
            <section class="gt-section gt-reveal">
                <h2 class="gt-section-title">Why Run With Us</h2>
                <p class="gt-body-text">We are a friendly, supportive community that helps you build confidence, strength, and a love for running — no matter where you start.</p>
            </section>

            <div class="gt-back">
                <a href="@Nav.BaseUri" class="gt-cta">← Back to Home</a>
            </div>
        }

    </div>
</div>

@code {
    private bool showDetails = false;
    private string activeTab = "beginners";
    private bool isTabFading = false;

    private async Task RevealDetails()
    {
        showDetails = true;
        StateHasChanged();
        await Task.Delay(50); // allow DOM to render the section
        await JS.InvokeVoidAsync("eval", "document.getElementById('what-we-do')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    private async Task SetTab(string tab)
    {
        if (activeTab == tab) return;
        isTabFading = true;
        StateHasChanged();
        await Task.Delay(250);
        activeTab = tab;
        isTabFading = false;
        StateHasChanged();
    }

    private record LeaderModel(string Name, string Role, string ImageUrl, string ShortBio, string FullBio);

    private readonly List<LeaderModel> leaders =
    [
        new("Sarah Connor", "Head Coach", "images/Women/headshot5.jpeg",
            "10 years coaching, marathon finisher, loves a muddy trail.",
            "Sarah has been coaching with STARC for 10 years. A multiple marathon finisher and ultrarunner, she is passionate about getting beginners off the couch and across finish lines."),
        new("James Murphy", "0–5K Lead", "images/team/james.png",
            "Couch to 5K graduate turned coach. Your biggest cheerleader.",
            "James started exactly where you are now — nervous, unfit, and unsure. He completed the 0–5K programme four years ago and never looked back."),
        new("Priya Nair", "Events Coordinator", "images/Women/headshot2.jpeg",
            "Organises all club events and races. Spreadsheet wizard.",
            "Priya keeps STARC's social and race calendar running like clockwork. From local parkruns to national marathons, she coordinates entries, logistics, and the all-important post-race celebrations."),
        new("Tom Brady", "Club Night Lead", "images/Men/headshot62.jpeg",
            "Wednesday night regular. Keeps the pace honest and the chat flowing.",
            "Tom has been a STARC regular for six years and took over leading Wednesday club nights two seasons ago. He prides himself on making sure no runner gets left behind on a dark winter evening."),
        new("Claire Doyle", "Beginners Mentor", "images/Women/headshot3.jpeg",
            "Qualified run leader and the friendliest face on the start line.",
            "Claire completed her run leader qualification after finishing the 0–5K programme herself. She now mentors every new intake, remembering exactly how daunting that first session can feel."),
        new("Declan Walsh", "Parkrun Ambassador", "images/Men/headshot63.jpeg",
            "Never missed a Saturday parkrun. Will talk you into your first one.",
            "Declan is STARC's unofficial parkrun evangelist. He organises the weekly group trip to the local course and is always on hand with a stopwatch, a smile, and a post-run coffee recommendation."),
        new("Aoife Brennan", "Social Secretary", "images/Women/headshot4.jpeg",
            "If there is a post-run celebration, Aoife planned it.",
            "Aoife keeps the social side of STARC alive — from summer BBQs to medal ceremonies and everything in between. She believes the craic after the run is just as important as the run itself."),
    ];
}
