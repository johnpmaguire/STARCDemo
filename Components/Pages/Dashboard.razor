@page "/dashboard"
@layout MemberLayout
@attribute [Authorize]
@inject DemoMemberService Members
@inject AuthenticationStateProvider AuthProvider
@inject AttendanceService Attendance
@using System.Security.Claims
@using STARCDemo.Models

<div class="member-page">
    @if (member is null)
    {
        <p class="member-loading">Loading...</p>
    }
    else
    {
        <section class="dash-welcome">
            <img src="@member.ProfilePicUrl" alt="@member.DisplayName" class="dash-avatar" />
            <div class="dash-welcome-text">
                <h1>Welcome back, <span>@member.DisplayName</span> 👋</h1>
                <p>
                    Member since @member.MemberSince.ToString("MMMM yyyy")
                    &nbsp;•&nbsp;
                    @if (member.IsActive)
                    {
                        <span class="badge badge-active">Active</span>
                    }
                    else
                    {

                        <span class="badge badge-inactive">Lapsed</span>
                    }
                </p>
            </div>
        </section>
        <section class="dash-section">
            <h2>📢 Announcements</h2>
            <div class="announcement-list">
                <div class="announcement-card announcement-warning">
                    <span class="announcement-icon">⚠️</span>
                    <div class="announcement-content">
                        <div class="announcement-title">Wednesday Session Cancelled</div>
                        <div class="announcement-body">Club night on 21 May is cancelled due to severe weather. Stay safe — see you next week!</div>
                        <div class="announcement-meta">Posted by Club Admin &nbsp;•&nbsp; 20 May 2025</div>
                    </div>
                </div>
                <div class="announcement-card announcement-info">
                    <span class="announcement-icon">📅</span>
                    <div class="announcement-content">
                        <div class="announcement-title">Club 5K Time Trial — Sunday 25 May</div>
                        <div class="announcement-body">Monthly time trial at the usual course. Meet at the car park at 8:15am. All abilities welcome.</div>
                        <div class="announcement-meta">Posted by Club Admin &nbsp;•&nbsp; 18 May 2025</div>
                    </div>
                </div>
                <div class="announcement-card announcement-success">
                    <span class="announcement-icon">🏆</span>
                    <div class="announcement-content">
                        <div class="announcement-title">Great performances at the County 10K!</div>
                        <div class="announcement-body">Congratulations to everyone who raced last weekend. Check the results board for details.</div>
                        <div class="announcement-meta">Posted by Club Admin &nbsp;•&nbsp; 15 May 2025</div>
                    </div>
                </div>
            </div>
        </section>
    
        <section class="dash-section">
            <h2>Club Sessions</h2>
            <div class="session-list">
                @foreach (var session in _sessions)
                {
                    var day = session.Day;
                    var isAttending = Attendance.IsAttending(member.Id, day, _weekStart);
                    var existing = Attendance.GetAttendance(member.Id, day, _weekStart);
                    var count = Attendance.GetAttendeeCount(day, _weekStart);

                    <div class="session-card @(isAttending ? "session-card-attending" : "")">
                        <span class="session-day">@day</span>
                        <span class="session-name">@session.Name</span>
                        <span class="session-detail">@session.Detail</span>

                        @{
                            var groupLeader = isAttending && existing is not null
                                ? Attendance.GetGroupLeader(day, _weekStart, existing.Group)
                                : null;
                        }
                        <div class="session-card-leader @(groupLeader is not null ? "session-card-leader-set" : "session-card-leader-tbc")">
                            <span>🏅</span>
                            @if (groupLeader is not null)
                            {
                                <span>@groupLeader.LeaderName</span>
                            }
                            else if (isAttending)
                            {
                                <span>Leader TBC</span>
                            }
                            else
                            {
                                <span>Sign up to see your leader</span>
                            }
                        </div>

                        @if (isAttending && existing is not null)
                        {
                            <div class="session-attendance-status">
                                <span class="session-attending-badge">✓ Attending &ndash; @existing.Group.DisplayName()</span>
                            </div>
                        }

                        <div class="session-attendance-controls">
                            @if (!isAttending)
                            {
                                <select class="session-group-select"
                                        value="@(_selectedGroups[day]?.ToString() ?? "")"
                                                @onchange="e => _selectedGroups[day] = string.IsNullOrEmpty(e.Value?.ToString()) ? null : Enum.Parse<RunGroup>(e.Value!.ToString()!)">
                                    <option value="">— Select Group —</option>
                                    @foreach (var g in Enum.GetValues<RunGroup>())
                                    {
                                        <option value="@g">@g.DisplayName()</option>
                                    }
                                </select>
                                <button class="btn-attend" @onclick="() => MarkAttending(day)" disabled="@(_selectedGroups[day] is null)">I'm coming</button>
                            }
                            else
                            {
                                <button class="btn-withdraw" @onclick="() => Withdraw(day)">Withdraw</button>
                            }
                        </div>

                        @if (count > 0)
                        {
                            <span class="session-count">@count @(count == 1 ? "member" : "members") signed up</span>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="dash-section">
            <h2>Become a Leader</h2>
            <div class="dash-info-card">
                <p>STARC is always looking for enthusiastic volunteers to help lead sessions. As a run leader you will:</p>
                <ul class="dash-info-list">
                    <li>Plan and lead group runs</li>
                    <li>Support and encourage members of all abilities</li>
                    <li>Be part of a friendly and supportive leadership team</li>
                </ul>
                <p>Interested? Speak to any committee member or email <a href="mailto:leaders@starc.example.com">leaders@starc.example.com</a></p>
            </div>
        </section>
    }
</div>

@code {
    private record ClubSession(string Day, string Name, string Detail);

    private static readonly ClubSession[] _sessions =
    [
        new("Monday",    "Social Run", "7:00pm • Car park meetup"),
        new("Wednesday", "Straight Run", "6:30pm • All abilities"),
        new("Friday",    "Intervals",  "6:00pm • Track session"),
        new("Sunday",    "Long Run",   "8:30am • Various routes"),
    ];

    private ClubMember? member;
    private DateOnly _weekStart = AttendanceService.CurrentWeekStart();
    private Dictionary<string, RunGroup?> _selectedGroups =
        new() { ["Monday"] = null, ["Wednesday"] = null,
                ["Friday"] = null, ["Sunday"] = null };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var username = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (username is not null)
            member = Members.GetByUsername(username);
    }

    private void MarkAttending(string sessionDay)
    {
        if (member is null) return;
        if (_selectedGroups[sessionDay] is null) return;
        Attendance.MarkAttending(member.Id, member.DisplayName, sessionDay, _weekStart, _selectedGroups[sessionDay]!.Value);
    }

    private void Withdraw(string sessionDay)
    {
        if (member is null) return;
        Attendance.Withdraw(member.Id, sessionDay, _weekStart);
    }
}

